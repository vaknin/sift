{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sift",
  "version": "0.1.0",
  "identifier": "dev.kivan.sift",
  "build": {
    "beforeDevCommand": { "script": "bun run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../ui" },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/build"
  },
  "app": {
    "windows": [{ "title": "sift", "width": 1600, "height": 1000, "minWidth": 900, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": { "enable": true, "scope": ["$CACHE/sift/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
